{
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "symfony/yaml": "^7.2",
        "twig/twig": "^3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11",
        "squizlabs/php_codesniffer": "^3",
        "wapmorgan/php-deprecation-detector": "^2",
        "rector/rector": "^2"
    },
    "scripts": {
        "test": "php vendor/bin/phpunit",
        "phpstan": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=-1",
        "pcf": "php vendor/bin/phpcs -d memory_limit=-1 --ignore=vendor/ --extensions=php,css .",
        "pcbf": "php vendor/bin/phpcbf -d memory_limit=-1 --ignore=vendor/ --extensions=php,css .",
        "deprecated": "php vendor/bin/phpdd -e vendor/ -t 8.1 ."
    },
    "autoload": {
        "psr-4": {
            "Ruubik\\": "src/",
            "Ruubik\\Tests\\": "tests/"
        }
    }
}
